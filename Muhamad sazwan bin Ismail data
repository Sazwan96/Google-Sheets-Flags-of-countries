/* ===== SIGINT ===== */
function initSigInt() {
  const canvas = document.getElementById('spectrumCanvas');
  if (canvas) {
    const ctx = canvas.getContext('2d'); const DPR = window.devicePixelRatio || 1;
    function resize() { canvas.width = canvas.clientWidth*DPR; canvas.height = canvas.clientHeight*DPR; ctx.setTransform(DPR,0,0,DPR,0,0); }
    resize(); window.addEventListener('resize', resize);
    const peaks = [{f:.08,h:.6,c:'#00e5ff'},{f:.18,h:.4,c:'#00ffd0'},{f:.32,h:.8,c:'#a78bfa'},{f:.47,h:.5,c:'#FFD700'},{f:.58,h:.9,c:'#ff6ec7'},{f:.72,h:.45,c:'#00e5ff'},{f:.85,h:.65,c:'#00ffd0'},{f:.93,h:.3,c:'#a78bfa'}];
    let tick = 0;
    (function draw() {
      const w = canvas.clientWidth, h = canvas.clientHeight;
      ctx.clearRect(0,0,w,h);
      ctx.strokeStyle = 'rgba(0,229,255,0.06)'; ctx.lineWidth = 1;
      for (let i=1;i<8;i++) { ctx.beginPath(); ctx.moveTo((w/8)*i,0); ctx.lineTo((w/8)*i,h); ctx.stroke(); }
      for (let i=1;i<4;i++) { ctx.beginPath(); ctx.moveTo(0,(h/4)*i); ctx.lineTo(w,(h/4)*i); ctx.stroke(); }
      peaks.forEach((p,i) => {
        const jit = Math.sin(tick*0.1+i)*0.03;
        const x = (p.f+jit)*w, ph = (p.h+Math.sin(tick*0.05+i)*0.1)*h;
        const grad = ctx.createLinearGradient(x-30,0,x+30,0);
        grad.addColorStop(0,p.c+'00'); grad.addColorStop(0.5,p.c+'AA'); grad.addColorStop(1,p.c+'00');
        ctx.fillStyle = grad; ctx.beginPath(); ctx.moveTo(x-40,h);
        for (let px=-40;px<=40;px++) ctx.lineTo(x+px, h-ph*Math.exp(-(px*px)/200));
        ctx.lineTo(x+40,h); ctx.closePath(); ctx.fill();
        ctx.strokeStyle = p.c; ctx.lineWidth = 2; ctx.shadowColor = p.c; ctx.shadowBlur = 8;
        ctx.beginPath(); ctx.moveTo(x,h); ctx.lineTo(x,h-ph); ctx.stroke(); ctx.shadowBlur = 0;
      });
      tick++;
      requestAnimationFrame(draw);
    })();
  }
  const freqs = [
    { freq: '30.5 MHz', type: 'hf' }, { freq: '118.2 MHz', type: 'vhf' },
