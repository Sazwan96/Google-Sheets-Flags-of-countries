}
body{background:var(--bg);color:var(--text);font-family:'Inter',sans-serif;padding:1.5rem 1rem;min-height:100vh;overflow-x:hidden;
 background-image:radial-gradient(ellipse at 20% 10%,rgba(0,229,255,0.05) 0%,transparent 55%),radial-gradient(ellipse at 80% 90%,rgba(255,215,0,0.05) 0%,transparent 55%);
 background-attachment:fixed}
