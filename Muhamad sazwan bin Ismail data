.milops-panel h2{background:linear-gradient(135deg,#ff4444,#ff8800)}
.geoint-panel h2{background:linear-gradient(135deg,var(--violet),var(--cyan))}
.fxmatrix-panel h2{background:linear-gradient(135deg,var(--gold),var(--btc-orange))}
.sigint-panel h2{background:linear-gradient(135deg,var(--cyan),var(--green))}
.timezone-panel h2{background:linear-gradient(135deg,var(--cyan),var(--gold))}
.finance-panel h2{background:linear-gradient(135deg,var(--finance-green),var(--cyan))}
.coop-panel h2{background:linear-gradient(135deg,#ff8fab,var(--gold))}
.sovereign-complete-panel h2{background:linear-gradient(135deg,var(--gold),var(--cyan))}
.biometric-panel h2{background:linear-gradient(135deg,var(--bio-mint),var(--cyan))}
.ginet-panel h2{background:linear-gradient(135deg,var(--cyan),var(--green))}
.portfolio-live-panel h2{background:linear-gradient(135deg,var(--bio-mint),var(--gold))}
.sysupdate-panel h2{background:linear-gradient(135deg,var(--violet),var(--cyan))}
.live-pulse{display:inline-block;width:10px;height:10px;background:var(--green);border-radius:50%;box-shadow:0 0 12px var(--green);animation:pulseLive 1.5s infinite;margin-right:8px}

/* METRICS */
.metric-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.8rem;margin-bottom:1.2rem;position:relative;z-index:2}
.metric-card{background:#0a121f;border:1px solid #2c5f8a;border-radius:16px;padding:.9rem;text-align:center;transition:.3s}
.metric-card:hover{border-color:var(--cyan);transform:translateY(-3px)}
.metric-card .mc-label{font-size:.5rem;text-transform:uppercase;color:var(--text-dim);letter-spacing:1px;margin-bottom:.3rem}
.metric-card .mc-value{font-size:1.4rem;font-weight:800;font-family:'Courier New',monospace;color:var(--cyan)}
.metric-card .mc-value.gold{color:var(--gold)}
.metric-card .mc-value.green{color:var(--green)}
.metric-card .mc-value.bio{color:var(--bio-mint)}
.metric-card .mc-value.violet{color:var(--violet)}
.metric-card .mc-sub{font-size:.5rem;color:var(--text-dim);margin-top:2px}

/* FEED */
.feed-panel,.mission-log,.version-timeline,.update-feed,.ginet-table,.portfolio-stream{background:#000;border-radius:12px;padding:.8rem;max-height:220px;overflow-y:auto;font-family:'Share Tech Mono','Courier New',monospace;font-size:.58rem;color:var(--text-dim);border:1px solid #1e293b;position:relative;z-index:2}
.feed-entry{padding:.3rem 0;border-bottom:1px solid rgba(255,255,255,.04);display:flex;gap:10px;animation:slideIn .4s ease-out}
.fe-time{color:var(--cyan);flex-shrink:0}
.fe-tag{font-weight:700;font-size:.5rem;padding:0 6px;border-radius:6px;flex-shrink:0}
.fe-tag.new{background:rgba(46,255,176,.15);color:var(--green)}
.fe-tag.fix{background:rgba(255,215,0,.15);color:var(--gold)}
.fe-tag.sec{background:rgba(251,113,133,.15);color:var(--rose)}
.fe-tag.ai{background:rgba(179,136,255,.15);color:var(--violet)}
.fe-tag.os{background:rgba(0,229,255,.15);color:var(--cyan)}
.fe-tag.bio{background:rgba(0,255,208,.15);color:var(--bio-mint)}
.fe-msg{color:var(--text);flex:1}

/* 3D */
#three3DContainer,.scene-3d-container{width:100%;height:460px;border-radius:20px;background:radial-gradient(ellipse at center,#0a1528 0%,#000 90%);border:1px solid rgba(0,229,255,.15);position:relative;overflow:hidden;cursor:grab}
.scene-3d-container{height:400px}
.scene-3d-container.hidden{display:none}
.scene-tabs{display:flex;gap:.4rem;margin-bottom:.8rem;flex-wrap:wrap;position:relative;z-index:2}
.scene-tab{padding:.4rem 1rem;border-radius:30px;font-size:.58rem;font-weight:700;cursor:pointer;letter-spacing:.5px;text-transform:uppercase;transition:.2s;background:rgba(0,229,255,.06);border:1px solid rgba(0,229,255,.25);color:var(--cyan)}
.scene-tab:hover{background:rgba(0,229,255,.15)}
.scene-tab.active{background:var(--cyan);color:#000;box-shadow:0 0 20px rgba(0,229,255,.4)}
.scene-tab.gold.active{background:var(--gold);border-color:var(--gold)}
.scene-tab.violet.active{background:var(--violet);border-color:var(--violet)}
.scene-tab.rose.active{background:var(--rose);border-color:var(--rose)}
.scene-tab.bio.active{background:var(--bio-mint);border-color:var(--bio-mint);color:#000}

/* BUTTONS */
.btn-row{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.8rem;position:relative;z-index:2}
.btn{background:rgba(0,229,255,.08);border:1px solid rgba(0,229,255,.3);color:var(--cyan);padding:.4rem 1rem;border-radius:30px;font-size:.58rem;font-weight:700;cursor:pointer;letter-spacing:.5px;text-transform:uppercase;transition:.2s}
.btn:hover{background:var(--cyan);color:#000;box-shadow:0 0 20px rgba(0,229,255,.4)}
.btn.gold{color:var(--gold);border-color:rgba(255,215,0,.35);background:rgba(255,215,0,.08)}
.btn.gold:hover{background:var(--gold);color:#000}
.btn.green{color:var(--green);border-color:rgba(46,255,176,.35);background:rgba(46,255,176,.08)}
.btn.green:hover{background:var(--green);color:#000}
.btn.bio{color:var(--bio-mint);border-color:rgba(0,255,208,.4);background:rgba(0,255,208,.08)}
.btn.bio:hover{background:var(--bio-mint);color:#000}
.btn.violet{color:var(--violet);border-color:rgba(167,139,250,.4);background:rgba(167,139,250,.08)}
.btn.violet:hover{background:var(--violet);color:#000}
.btn.rose{color:var(--rose);border-color:rgba(251,113,133,.4);background:rgba(251,113,133,.08)}
.btn.rose:hover{background:var(--rose);color:#000}

/* MILOPS */
.milops-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:.7rem;margin-bottom:1rem;position:relative;z-index:2}
.milops-card{background:rgba(0,0,0,.6);border:1px solid rgba(255,68,68,.25);border-left:3px solid #ff4444;border-radius:14px;padding:.75rem}
.milops-card.green{border-left-color:var(--green)}
.milops-card.cyan{border-left-color:var(--cyan)}
.milops-card.gold{border-left-color:var(--gold)}
.milops-card.bio{border-left-color:var(--bio-mint)}
.milops-card .mc-label{font-size:.48rem;color:var(--text-dim);text-transform:uppercase;letter-spacing:1px;font-weight:700}
.milops-card .mc-value{font-size:1.3rem;font-weight:900;font-family:'Courier New',monospace;color:#ff4444;margin-top:3px}
.milops-card.green .mc-value{color:var(--green)}
.milops-card.cyan .mc-value{color:var(--cyan)}
.milops-card.gold .mc-value{color:var(--gold)}
.milops-card.bio .mc-value{color:var(--bio-mint)}
.milops-card .mc-sub{font-size:.5rem;color:var(--text-dim);margin-top:3px}
.defcon-badge{display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:30px;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;font-size:.65rem}
.defcon-3{background:rgba(255,215,0,.15);color:var(--gold);border:2px solid var(--gold);animation:pulseLive 2s infinite}
.defcon-5{background:rgba(46,255,176,.15);color:var(--green);border:2px solid var(--green)}
.milops-units{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:.6rem;position:relative;z-index:2}
.unit-card{background:rgba(0,0,0,.5);border:1px solid rgba(255,68,68,.2);border-radius:12px;padding:.7rem;display:flex;align-items:center;gap:10px}
.unit-icon{width:34px;height:34px;border-radius:50%;background:rgba(255,68,68,.15);display:flex;align-items:center;justify-content:center;color:#ff4444;flex-shrink:0}
.unit-info{flex:1;min-width:0}
.unit-name{font-size:.68rem;font-weight:700;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.unit-meta{font-size:.5rem;color:var(--text-dim);font-family:'Share Tech Mono',monospace;margin-top:2px}
.unit-status{font-size:.5rem;font-weight:700;padding:2px 8px;border-radius:20px;text-transform:uppercase}
.unit-status.ready{background:rgba(46,255,176,.15);color:var(--green)}
.unit-status.deployed{background:rgba(255,215,0,.15);color:var(--gold);animation:pulseLive 1.5s infinite}
.unit-status.standby{background:rgba(0,229,255,.15);color:var(--cyan)}
.unit-status.alert{background:rgba(255,68,68,.2);color:#ff4444;animation:pulseLive 1s infinite}
.mission-log-row{display:grid;grid-template-columns:60px 70px 1fr auto;gap:8px;padding:.3rem 0;border-bottom:1px solid rgba(255,68,68,.06);align-items:center;animation:slideIn .4s ease-out}
.ml-time{color:var(--cyan)}
.ml-op{font-weight:800;font-size:.5rem;padding:1px 6px;border-radius:5px;text-align:center;text-transform:uppercase}
.ml-op.recon{background:rgba(0,229,255,.15);color:var(--cyan)}
.ml-op.cyber{background:rgba(167,139,250,.15);color:var(--violet)}
.ml-op.intel{background:rgba(255,215,0,.15);color:var(--gold)}
.ml-op.strike{background:rgba(255,68,68,.2);color:#ff4444}
.ml-op.defend{background:rgba(46,255,176,.15);color:var(--green)}
.ml-op.bio{background:rgba(0,255,208,.15);color:var(--bio-mint)}
.ml-msg{color:var(--text)}
.ml-status{font-size:.5rem;font-weight:700;color:var(--green)}

/* GEOINT / FX / SIGINT / TZ */
.geoint-grid,.fx-grid,.tz-grid,.coop-grid,.commodity-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:.6rem;position:relative;z-index:2}
.threat-level-card{background:rgba(0,0,0,.6);border-radius:14px;padding:.8rem;border:1px solid rgba(179,136,255,.15)}
.tl-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:.4rem}
.tl-country{font-size:.72rem;font-weight:800;color:var(--text);display:flex;align-items:center;gap:6px}
.tl-flag{font-size:1.3rem}
.tl-level{font-size:.5rem;font-weight:800;padding:3px 10px;border-radius:20px;text-transform:uppercase}
.tl-level.severe{background:rgba(255,68,68,.2);color:#ff4444;animation:pulseLive 1s infinite}
.tl-level.high{background:rgba(255,145,0,.2);color:#ff9100}
.tl-level.elevated{background:rgba(255,215,0,.2);color:var(--gold)}
.tl-level.moderate{background:rgba(0,229,255,.15);color:var(--cyan)}
.tl-level.low{background:rgba(46,255,176,.15);color:var(--green)}
.tl-metrics{display:grid;grid-template-columns:1fr 1fr;gap:.4rem;font-size:.55rem;margin-top:.4rem}
.tl-metric{background:rgba(0,0,0,.3);border-radius:6px;padding:.3rem .5rem}
.tl-m-label{color:var(--text-dim);text-transform:uppercase;font-size:.45rem}
.tl-m-val{font-family:'Share Tech Mono',monospace;font-weight:800;color:var(--cyan);font-size:.68rem;margin-top:1px}
.alliance-matrix{background:rgba(0,0,0,.5);border-radius:14px;padding:.9rem;border:1px solid rgba(179,136,255,.15);margin-top:.8rem;position:relative;z-index:2}
.alliance-matrix h4{font-size:.62rem;color:var(--violet);text-transform:uppercase;letter-spacing:1px;margin-bottom:.6rem;font-weight:800}
.alliance-item{display:flex;align-items:center;gap:8px;padding:.35rem 0;border-bottom:1px solid rgba(255,255,255,.04);font-size:.58rem}
.ai-name{color:var(--text);font-weight:700;min-width:120px}
.ai-bar{flex:1;height:6px;background:rgba(179,136,255,.1);border-radius:4px;overflow:hidden}
.ai-bar>div{height:100%;border-radius:4px;background:linear-gradient(90deg,var(--violet),var(--cyan));transition:width .6s}
.ai-pct{font-family:'Share Tech Mono',monospace;font-weight:800;color:var(--cyan);font-size:.58rem;min-width:40px;text-align:right}
.ai-status{font-size:.5rem;font-weight:700;padding:2px 8px;border-radius:10px;min-width:60px;text-align:center}
.ai-status.allied{background:rgba(46,255,176,.15);color:var(--green)}
.ai-status.partner{background:rgba(0,229,255,.15);color:var(--cyan)}
.ai-status.neutral{background:rgba(255,215,0,.15);color:var(--gold)}
.ai-status.watch{background:rgba(255,68,68,.15);color:#ff4444}

.fx-item{background:rgba(0,0,0,.6);border:1px solid rgba(255,215,0,.15);border-radius:12px;padding:.7rem;transition:.2s}
.fx-item:hover{border-color:var(--gold);transform:translateY(-2px)}
.fx-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:.4rem}
.fx-pair{font-size:.68rem;font-weight:800;color:var(--text);font-family:'Share Tech Mono',monospace}
.fx-flag{font-size:1rem}
.fx-price{font-size:1.05rem;font-weight:800;font-family:'Share Tech Mono',monospace;color:var(--gold)}
.fx-change{font-size:.55rem;font-weight:700;margin-top:3px;display:flex;justify-content:space-between}
.fx-change .up{color:var(--green)}.fx-change .down{color:var(--rose)}.fx-change .label{color:var(--text-dim)}

.commodity-item{background:rgba(0,0,0,.5);border:1px solid rgba(255,215,0,.2);border-radius:12px;padding:.7rem;display:flex;align-items:center;gap:10px}
.ci-icon{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0}
.ci-icon.oil{background:rgba(139,69,19,.2);color:#8b4513}
.ci-icon.gold{background:rgba(255,215,0,.15);color:var(--gold)}
.ci-icon.silver{background:rgba(192,192,192,.15);color:#c0c0c0}
.ci-icon.copper{background:rgba(184,115,51,.2);color:#b87333}
.ci-icon.platinum{background:rgba(229,228,226,.15);color:#e5e4e2}
.ci-icon.gas{background:rgba(0,229,255,.15);color:var(--cyan)}
.ci-name{font-size:.62rem;font-weight:700;color:var(--text)}
.ci-price{font-size:.85rem;font-weight:800;font-family:'Share Tech Mono',monospace;color:var(--gold);margin-top:2px}
.ci-change{font-size:.5rem;font-weight:700;margin-top:2px}

.spectrum-display{background:#000;border-radius:14px;border:1px solid rgba(0,229,255,.3);padding:1rem;position:relative;z-index:2;margin-bottom:1rem}
.spectrum-canvas{width:100%;height:120px;display:block;border-radius:8px}
.spectrum-labels{display:flex;justify-content:space-between;font-family:'Share Tech Mono',monospace;font-size:.5rem;color:var(--text-dim);margin-top:.5rem}
.freq-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:.5rem;position:relative;z-index:2}
.freq-item{background:rgba(0,0,0,.5);border:1px solid rgba(0,229,255,.15);border-radius:10px;padding:.6rem .8rem;display:flex;justify-content:space-between;align-items:center;font-family:'Share Tech Mono',monospace;font-size:.58rem}
.fi-freq{color:var(--cyan);font-weight:800}
.fi-type{font-size:.5rem;padding:2px 8px;border-radius:10px;font-weight:700;text-transform:uppercase}
.fi-type.vhf{background:rgba(0,229,255,.15);color:var(--cyan)}
.fi-type.uhf{background:rgba(46,255,176,.15);color:var(--green)}
.fi-type.shf{background:rgba(167,139,250,.15);color:var(--violet)}
.fi-type.hf{background:rgba(255,215,0,.15);color:var(--gold)}
.fi-type.sat{background:rgba(255,110,199,.15);color:var(--quantum-pink)}
.fi-signal{font-size:.5rem;font-weight:700;color:var(--green)}

.tz-clock-utc{text-align:center;background:rgba(0,0,0,.6);border-radius:16px;padding:.8rem 1.5rem;border:2px solid var(--gold);margin-bottom:1rem;position:relative;z-index:2}
.tz-utc-label{font-size:.55rem;color:var(--text-dim);letter-spacing:3px;text-transform:uppercase;font-weight:700}
.tz-utc-time{font-family:'Share Tech Mono',monospace;font-size:1.8rem;font-weight:900;color:var(--gold);letter-spacing:3px;margin-top:.3rem;text-shadow:0 0 20px rgba(255,215,0,.4)}
.tz-utc-date{font-size:.58rem;color:var(--cyan);margin-top:.3rem;font-family:'Share Tech Mono',monospace}
.tz-item{background:rgba(0,0,0,.5);border:1px solid rgba(0,229,255,.15);border-radius:10px;padding:.6rem .8rem;display:flex;align-items:center;gap:10px}
.tz-flag{font-size:1.3rem;flex-shrink:0}
.tz-info{flex:1;min-width:0}
.tz-city{font-size:.62rem;font-weight:700;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tz-offset{font-size:.5rem;color:var(--text-dim);font-family:'Share Tech Mono',monospace}
.tz-time{font-family:'Share Tech Mono',monospace;font-size:.85rem;font-weight:800;color:var(--cyan);flex-shrink:0}
.tz-time.market-open{color:var(--green)}
.tz-time.market-closed{color:var(--rose)}

.finance-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.7rem;margin:.8rem 0;position:relative;z-index:2}
.finance-kpi{background:linear-gradient(160deg,#000,#02070e);border:1px solid rgba(0,214,143,.3);border-left:4px solid var(--finance-green);border-radius:14px;padding:.9rem;text-align:center}
.fk-label{font-size:.5rem;text-transform:uppercase;color:var(--text-dim);letter-spacing:1px}
.fk-value{font-size:1.35rem;font-weight:900;color:var(--finance-green);font-family:'Share Tech Mono',monospace;margin:.3rem 0}
.fk-change{font-size:.58rem;font-weight:700}
.fk-change.up{color:var(--finance-green)}

.coop-card{background:linear-gradient(160deg,#0a0a1a,#02070e);border:1px solid rgba(255,143,171,.3);border-left:4px solid #ff8fab;border-radius:14px;padding:.8rem}
.cc-title{font-size:.72rem;font-weight:800;color:#ff8fab;margin-bottom:.3rem}
.cc-body{font-size:.58rem;color:#c7d9ef;line-height:1.6}
.cc-stats{display:flex;gap:.5rem;margin-top:.5rem;flex-wrap:wrap}
.cc-stat{background:#000;border-radius:8px;padding:.2rem .5rem;font-size:.5rem;font-weight:700;color:var(--gold)}

/* SOVEREIGN */
.sovereign-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:.5rem;margin-bottom:1rem;position:relative;z-index:2}
.sovereign-filter{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:.8rem;position:relative;z-index:2}
.sovereign-filter input,.sovereign-filter select{padding:.5rem 1rem;border-radius:14px;background:#0a121f;border:1px solid #2c5f8a;color:#fff;font-size:.68rem;outline:none}
.sovereign-filter input{flex:1;min-width:200px}
.sovereign-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:.7rem;max-height:800px;overflow-y:auto;background:rgba(0,0,0,.3);border-radius:16px;padding:.8rem;border:1px solid rgba(0,229,255,.15);position:relative;z-index:2}
.sovereign-item{background:rgba(10,18,31,.85);border:1px solid rgba(0,229,255,.15);border-radius:14px;padding:.8rem;transition:.2s}
.sovereign-item:hover{border-color:var(--gold);transform:translateY(-2px)}

/* BIOMETRIC */
.bio-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.7rem;position:relative;z-index:2;margin-top:.8rem}
.bio-card{background:rgba(0,0,0,.6);border:1px solid rgba(0,255,208,.25);border-left:3px solid var(--bio-mint);border-radius:14px;padding:.75rem}
.bc-label{font-size:.5rem;color:var(--text-dim);text-transform:uppercase;letter-spacing:1px;font-weight:700}
.bc-value{font-size:1.05rem;font-weight:900;font-family:'Share Tech Mono',monospace;color:var(--bio-mint);margin-top:3px}
.bc-sub{font-size:.5rem;color:var(--text-dim);margin-top:3px}
.bio-verify-table{width:100%;border-collapse:collapse;font-size:.62rem;margin-top:.9rem;position:relative;z-index:2}
.bio-verify-table tr{border-bottom:1px solid rgba(0,255,208,.12)}
.bio-verify-table td{padding:.45rem .3rem}
.bio-verify-table td:first-child{color:var(--text-dim);text-transform:uppercase;font-size:.52rem}
.bio-verify-table td:last-child{text-align:right;color:var(--bio-mint);font-family:'Share Tech Mono',monospace;font-weight:700}
.bio-verify-table tr.ok td:last-child::before{content:'✅ ';color:var(--green)}

/* GINET */
.ginet-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.6rem;position:relative;z-index:2;margin-bottom:1rem}
.ginet-card{background:rgba(0,0,0,.65);border:1px solid rgba(0,229,255,.2);border-left:3px solid var(--cyan);border-radius:12px;padding:.7rem}
.ginet-card .g-label{font-size:.48rem;color:var(--text-dim);text-transform:uppercase;letter-spacing:1px;font-weight:700}
.ginet-card .g-value{font-size:1.2rem;font-weight:900;font-family:'Share Tech Mono',monospace;color:var(--cyan);margin-top:.3rem}
.ginet-card .g-value.green{color:var(--green)}
.ginet-card .g-value.gold{color:var(--gold)}
.ginet-card .g-value.violet{color:var(--violet)}
.ginet-card .g-value.rose{color:var(--rose)}
.ginet-card .g-sub{font-size:.48rem;color:var(--text-dim);margin-top:3px}
.ginet-row{display:grid;grid-template-columns:70px 1fr 80px 60px 55px;gap:8px;padding:.35rem .3rem;border-bottom:1px solid rgba(0,229,255,.06);font-family:'Share Tech Mono',monospace;font-size:.55rem;align-items:center;animation:slideIn .4s ease-out}
.gr-flag{font-size:.95rem}
.gr-country{color:var(--text);font-weight:700;font-size:.6rem;font-family:'Inter',sans-serif}
.gr-isp{color:var(--text-dim);font-size:.5rem}
.gr-speed{color:var(--cyan);font-weight:800;text-align:right}
.gr-lat{color:var(--gold);font-weight:800;text-align:right}
