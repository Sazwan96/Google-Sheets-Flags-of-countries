/* ===== SEAL HERO ===== */
.seal-hero{background:radial-gradient(ellipse at center,#1a1500 0%,#0a0800 60%,#000 100%);border:3px double var(--gold);border-radius:32px;padding:2rem;margin-bottom:1.5rem;position:relative;overflow:hidden;box-shadow:0 0 60px rgba(255,215,0,.25),inset 0 0 60px rgba(255,215,0,.08)}
.seal-hero::before{content:'';position:absolute;inset:-50%;background:conic-gradient(from 0deg,transparent,rgba(255,215,0,.1),transparent,rgba(255,215,0,.1),transparent);animation:rotateGlow 14s linear infinite;pointer-events:none}
.seal-hero::after{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);animation:scanLine 5s linear infinite;pointer-events:none;box-shadow:0 0 12px var(--gold)}
.seal-hero-inner{position:relative;z-index:2;display:flex;align-items:center;gap:2rem;flex-wrap:wrap;justify-content:center}
.seal-main{flex-shrink:0;animation:sealPulse 4s infinite}
.seal-info{flex:1;min-width:280px;max-width:600px}
.seal-info h1{font-family:'Cinzel',serif;font-size:1.6rem;font-weight:900;background:linear-gradient(135deg,#fff5c0,var(--gold),#b45309);-webkit-background-clip:text;background-clip:text;color:transparent;letter-spacing:3px;text-align:center;margin-bottom:.5rem}
.seal-info .subtitle{text-align:center;font-size:.65rem;color:var(--bio-mint);letter-spacing:4px;text-transform:uppercase;font-family:'Share Tech Mono',monospace;margin-bottom:1rem}
.seal-cert{background:rgba(0,0,0,.7);border:1px solid rgba(255,215,0,.35);border-radius:16px;padding:.9rem 1rem}
.seal-cert-row{display:flex;justify-content:space-between;padding:.3rem 0;border-bottom:1px dashed rgba(255,215,0,.15);font-size:.65rem}
.seal-cert-row:last-child{border:none}
.scr-k{color:var(--text-dim);text-transform:uppercase;letter-spacing:1px;font-size:.5rem}
.scr-v{color:var(--gold);font-family:'Share Tech Mono',monospace;font-weight:800}
.scr-v.bio{color:var(--bio-mint)}
.scr-v.cyan{color:var(--cyan)}
.seal-hash{margin-top:.6rem;background:#000;border-left:3px solid var(--bio-mint);border-radius:8px;padding:6px 10px;font-family:'Share Tech Mono',monospace;font-size:.55rem;color:var(--bio-mint);word-break:break-all}
.seal-badges{display:flex;gap:.4rem;flex-wrap:wrap;justify-content:center;margin-top:.8rem}
.seal-badge{font-size:.5rem;padding:.28rem .7rem;border-radius:20px;font-weight:800;letter-spacing:.5px;text-transform:uppercase;border:1px solid}
.seal-badge.gold{background:rgba(255,215,0,.1);color:var(--gold);border-color:var(--gold)}
.seal-badge.bio{background:rgba(0,255,208,.1);color:var(--bio-mint);border-color:var(--bio-mint);animation:pulseLive 2.5s infinite}
.seal-badge.cyan{background:rgba(0,229,255,.1);color:var(--cyan);border-color:var(--cyan)}
.seal-badge.violet{background:rgba(167,139,250,.1);color:var(--violet);border-color:var(--violet)}

/* ===== FLAG & COOP GRID ===== */
.flag-coop-panel{background:linear-gradient(160deg,#000,#02070e);border:2px solid rgba(0,229,255,.4);border-radius:32px;padding:1.5rem;margin:2rem 0;box-shadow:0 0 50px rgba(0,229,255,.12)}
