/* FINGERPRINT */
.fingerprint-block{background:linear-gradient(160deg,#000,#001a16);border:1px solid rgba(0,255,208,.4);border-radius:20px;padding:.9rem;margin:1rem 0;position:relative;overflow:hidden}
