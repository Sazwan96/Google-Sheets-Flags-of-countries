/* ===== LOGIN ===== */
#loginOverlay{position:fixed;inset:0;background:rgba(0,0,0,.97);backdrop-filter:blur(22px);display:flex;align-items:center;justify-content:center;z-index:9999}
#loginOverlay.hidden{display:none}
.login-card{background:#0a0f17;border:1.5px solid var(--cyan);border-radius:2.2rem;padding:2.2rem;width:440px;max-width:92vw;text-align:center;box-shadow:0 0 55px rgba(0,229,255,.25)}
